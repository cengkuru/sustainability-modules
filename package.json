{
  "name": "new-modules-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "build:stats": "ng build --configuration production --stats-json",
    "analyze": "npm run build:stats && npx webpack-bundle-analyzer dist/new-modules-app/stats.json",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "server": "node server/server.js",
    "dev": "concurrently \"npm run start\" \"npm run server\"",
    "migrate": "node server/migration/run-migration.js",
    "test-mongo": "node server/test-mongodb-connection.js",
    "check-ip": "node scripts/check-mongodb-access.js",
    "toggle-db": "node scripts/toggle-database.js"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.1.7",
    "@angular/common": "^20.1.7",
    "@angular/compiler": "^20.1.7",
    "@angular/core": "^20.1.7",
    "@angular/forms": "^20.1.7",
    "@angular/platform-browser": "^20.1.7",
    "@angular/platform-browser-dynamic": "^20.1.7",
    "@angular/router": "^20.1.7",
    "@ng-icons/core": "^29.0.0",
    "@ng-icons/heroicons": "^29.0.0",
    "@ngx-translate/core": "^15.0.0",
    "@ngx-translate/http-loader": "^8.0.0",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.13",
    "@types/file-saver": "^2.0.7",
    "@types/jspdf": "^2.0.0",
    "bootstrap-icons": "^1.11.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "echarts": "^5.5.0",
    "express": "^4.21.2",
    "file-saver": "^2.0.5",
    "jspdf": "^2.5.1",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "mongoose": "^8.13.0",
    "ngx-echarts": "^17.1.0",
    "ngx-json-viewer": "^3.2.1",
    "ngx-toastr": "^19.0.0",
    "node-fetch": "^2.7.0",
    "nodemailer": "^7.0.5",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "xlsx": "^0.18.5",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.1.6",
    "@angular/cli": "^20.1.6",
    "@angular/compiler-cli": "^20.1.7",
    "@types/jasmine": "~5.1.0",
    "@types/leaflet": "^1.9.12",
    "@types/leaflet.markercluster": "^1.5.5",
    "autoprefixer": "^10.4.19",
    "concurrently": "^9.1.2",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "~5.8.3"
  }
